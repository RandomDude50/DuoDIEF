# Copia in .env e compila. Non committare il file .env.

# Porta del server HTTP
PORT=3000

# Ambiente: "production" rende obbligatorio JWT_SECRET
NODE_ENV=development

# Segreto per firmare i token di login. Generane uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Percorso del database SQLite (creato automaticamente al primo avvio)
DB_PATH=./quiz.db

# Durata in millisecondi della schermata con la risposta corretta
REVEAL_MS=4500
